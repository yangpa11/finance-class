rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.uid == 'ydeks1UXjEONH8vDQv398skiQCr1';
    }

    function isKnownClass(classId) {
      return classId in ['1-1', '1-2', '1-3', '2-1', '2-2', '2-3'];
    }

    function hasValidProgressShape(classId) {
      return request.resource.data.keys().hasAll([
          'classId',
          'completedLessons',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'classId',
          'completedLessons',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.classId == classId
        && request.resource.data.completedLessons is list
        && request.resource.data.completedLessons.size() <= 16
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /classProgress/{classId} {
      allow read: if isTeacher() && isKnownClass(classId);
      allow create, update: if isTeacher()
        && isKnownClass(classId)
        && hasValidProgressShape(classId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
